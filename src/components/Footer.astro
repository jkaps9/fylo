---
import Logo from "./Logo.astro";
---

<footer>
  <div class="container">
    <Logo />
    <ul class="contact-info">
      <li class="contact-info__item">
        <img
          src="/fylo/assets/images/icon-location.svg"
          alt=""
        />
        <p>
          Lorem ipsum dolor sit, amet consectetur adipisicing elit. Facere atque
          quod porro ratione repellat id impedit magnam dolore quis.
        </p>
      </li>
      <li class="contact-info__item">
        <img
          src="/fylo/assets/images/icon-phone.svg"
          alt=""
        />
        <p>+1-543-123-4567</p>
      </li>
      <li class="contact-info__item">
        <img
          src="/fylo/assets/images/icon-email.svg"
          alt=""
        />
        <p>example@fylo.com</p>
      </li>
    </ul>
    <ul class="page-links">
      <li class="page-links__item">About Us</li>
      <li class="page-links__item">Jobs</li>
      <li class="page-links__item">Press</li>
      <li class="page-links__item">Blog</li>
    </ul>
    <ul class="other-links">
      <li class="other-links__item">Contact Us</li>
      <li class="other-links__item">Terms</li>
      <li class="other-links__item">Privacy</li>
    </ul>
    <ul class="social-links">
      <li class="social-links__item">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          stroke-width="0.5"
          stroke="#ffffff"
          fill="#ffffff"
          class="fill-hover"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            stroke="none"
            d="M0 0h24v24H0z"
            fill="none"
          >
          </path>
          <path
            d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
          >
          </path>
        </svg>
      </li>
      <li class="social-links__item">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="fill-hover"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          stroke-width="0.5"
          stroke="#ffffff"
          fill="#ffffff"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            stroke="none"
            d="M0 0h24v24H0z"
            fill="none"
          >
          </path>
          <path
            d="M22 4.01c-1 .49 -1.98 .689 -3 .99c-1.121 -1.265 -2.783 -1.335 -4.38 -.737s-2.643 2.06 -2.62 3.737v1c-3.245 .083 -6.135 -1.395 -8 -4c0 0 -4.182 7.433 4 11c-1.872 1.247 -3.739 2.088 -6 2c3.308 1.803 6.913 2.423 10.034 1.517c3.58 -1.04 6.522 -3.723 7.651 -7.742a13.84 13.84 0 0 0 .497 -3.753c-.002 -.249 1.51 -2.772 1.818 -4.013z"
          >
          </path>
        </svg>
      </li>
      <li class="social-links__item">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="#ffffff"
          fill="transparent"
          class="stroke-hover"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            stroke="none"
            d="M0 0h24v24H0z"
            fill="none"
          >
          </path>
          <rect
            x="4"
            y="4"
            width="16"
            height="16"
            rx="4"
          >
          </rect>
          <circle
            cx="12"
            cy="12"
            r="3"
          >
          </circle>
          <line
            x1="16.5"
            y1="7.5"
            x2="16.5"
            y2="7.501"
          >
          </line>
        </svg>
      </li>
    </ul>
  </div>
</footer>

<style lang="scss">
  footer {
    background-color: $colors-navy-950;
    padding-top: clamp(10.125rem, 18.4067rem + -9.2019vw, 16.25rem);
    padding-bottom: clamp(3rem, 2.8239rem + 0.7512vw, 3.5rem);
    .container {
      display: flex;
      flex-direction: column;
      gap: $spacing-500;

      @include lib.respond-to(lg) {
        align-items: start;
        display: grid;
      }
    }

    :global(.logo) {
      grid-column: 1 / span 4;
    }

    ul {
      list-style-type: none;
      display: flex;
      flex-direction: column;
      gap: $spacing-200;
      padding: 0;

      li {
        align-items: flex-start;
        display: flex;
        gap: $spacing-200;

        &:hover {
          cursor: pointer;
          font-weight: 700;
        }
      }

      &.social-links {
        align-items: center;
        flex-direction: row;
        margin: 0 auto;

        .social-links__item {
          border: 1px solid $colors-white;
          border-radius: lib.$radius-full;
          padding: 4px;
          transform: translateY(0);
          transition: transform 0.3s ease 0.1s;

          &:hover {
            cursor: pointer;
            border-color: $colors-blue-300;
            transform: translateY(-4px);

            .fill-hover {
              fill: $colors-blue-300;
            }
            .stroke-hover {
              stroke: $colors-blue-300;
            }
          }
        }
      }

      &.contact-info {
        @include lib.respond-to(md) {
          display: grid;
          grid-template-columns: 1fr auto;
          justify-items: end;
          max-width: lib.rem(632);
          & > li:first-child {
            grid-row: 1 / span 2;
          }
        }

        @include lib.respond-to(lg) {
          justify-items: start;
        }
      }
    }
  }
</style>
