---
import Logo from "./Logo.astro";
---

<footer>
  <div class="container">
    <Logo />
    <ul class="contact-info">
      <li class="contact-info__item">
        <img
          src="/src/assets/images/icon-location.svg"
          alt=""
        />
        <p>
          Lorem ipsum dolor sit, amet consectetur adipisicing elit. Facere atque
          quod porro ratione repellat id impedit magnam dolore quis.
        </p>
      </li>
      <li class="contact-info__item">
        <img
          src="/src/assets/images/icon-phone.svg"
          alt=""
        />
        <p>+1-543-123-4567</p>
      </li>
      <li class="contact-info__item">
        <img
          src="/src/assets/images/icon-email.svg"
          alt=""
        />
        <p>example@fylo.com</p>
      </li>
    </ul>
    <ul class="page-links">
      <li class="page-links__item">About Us</li>
      <li class="page-links__item">Jobs</li>
      <li class="page-links__item">Press</li>
      <li class="page-links__item">Blog</li>
    </ul>
    <ul class="other-links">
      <li class="other-links__item">Contact Us</li>
      <li class="other-links__item">Terms</li>
      <li class="other-links__item">Privacy</li>
    </ul>
    <ul class="social-links">
      <li class="social-links__item">
        <img
          src="/src/assets/images/facebook.svg"
          alt=""
        />
      </li>
      <li class="social-links__item">
        <img
          src="/src/assets/images/twitter.svg"
          alt=""
        />
      </li>
      <li class="social-links__item">
        <img
          src="/src/assets/images/instagram.svg"
          alt=""
        />
      </li>
    </ul>
  </div>
</footer>

<style lang="scss">
  footer {
    background-color: $colors-navy-950;
    padding-bottom: 3rem;
    .container {
      display: flex;
      flex-direction: column;
      gap: $spacing-500;
    }

    ul {
      list-style-type: none;
      display: flex;
      flex-direction: column;
      gap: $spacing-200;
      padding: 0;

      li {
        align-items: flex-start;
        display: flex;
        gap: $spacing-200;
      }

      &.social-links {
        flex-direction: row;
        margin: 0 auto;

        .social-links__item {
          border: 1px solid $colors-white;
          border-radius: lib.$radius-full;
          padding: 4px;
        }
      }
    }
  }
</style>
