---
import Button from "./Button.astro";
---

<section class="hero">
  <div class="hero__bg-image">
    <picture>
      <source
        media="(min-width: 376px)"
        srcset="../assets/images/bg-curvy-desktop.svg"
      />
      <img
        src="../assets/images/bg-curvy-mobile.svg"
        alt=""
        aria-hidden="true"
      />
    </picture>
  </div>
  <div class="container">
    <div class="hero__image">
      <img
        src="../assets/images/illustration-intro.png"
        alt="illustration of two people; one taking a file out of a big folder, the other putting a file into the big folder. the big folder has a bunch of files in it"
        aria-hidden="true"
      />
    </div>
    <div class="hero__text">
      <h2>All your files in one secure location, accessible anywhere.</h2>
      <p>
        Fylo stores all your most important files in one secure location. Access
        them wherever you need, share and collaborate with friends family, and
        co-workers.
      </p>
      <Button text="Get Started" />
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    margin: $spacing-500 0 0;
    position: relative;
    .container {
      @include lib.flex-center(column);
      gap: clamp($spacing-600, 4.8521rem + -1.5023vw, $spacing-900);
      max-width: lib.rem(734);
    }
    &__bg-image {
      position: absolute;
      bottom: 0;
      display: flex;
      justify-content: center;
      left: 0;
      right: 0;
      width: 100%;
      z-index: -1;
    }
    &__text {
      @include lib.flex-center(column);
      align-self: stretch;
      gap: clamp($spacing-300, 1.1479rem + 1.5023vw, $spacing-500);
      text-align: center;

      p {
        font-size: clamp(0.875rem, 0.743rem + 0.5634vw, 1.25rem);
      }
    }
  }
</style>
