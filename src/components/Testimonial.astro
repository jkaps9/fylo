---
const { quote, authorName, authorTitle, authorImage } = Astro.props;
---

<div class="testimonial">
  <blockquote>
    <p>
      {quote}
    </p>
  </blockquote>
  <div class="author">
    <div class="author__image">
      <img
        src={authorImage}
        alt=`{authorName} image`
      />
    </div>
    <div class="author__name-and-title">
      <p>{authorName}</p>
      <cite>{authorTitle}</cite>
    </div>
  </div>
</div>

<style lang="scss">
  .testimonial {
    @include lib.flex-center(column);
    align-items: flex-start;
    background: $colors-navy-800;
    border-radius: 4px;
    gap: $spacing-300;
    max-width: lib.rem(480);
    padding: clamp($spacing-300, 1.3239rem + 0.7512vw, $spacing-400)
      $spacing-300;

    position: relative;
    z-index: 2;
  }

  .author {
    @include lib.flex-center();
    gap: $spacing-100;

    &__image {
      border-radius: lib.$radius-full;
      max-height: 1.5rem;
      max-width: 1.5rem;
      overflow: hidden;
    }

    &__name-and-title {
      @include lib.flex-center(column);
      align-items: flex-start;
      p {
        font-size: lib.rem(10);
        font-weight: 700;
        letter-spacing: 0.5px;
      }
      cite {
        font-size: lib.rem(8);
        letter-spacing: 0.5px;
        font-style: normal;
      }
    }
  }
</style>
