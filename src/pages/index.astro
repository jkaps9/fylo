---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Feature from "../components/Feature.astro";
import Productive from "../components/Productive.astro";
import Testimonial from "../components/Testimonial.astro";
import CTA from "../components/CTA.astro";
import "../styles/global.scss";
---

<Layout>
  <Hero />
  <section class="features">
    <div class="container">
      <Feature
        imagePath="/fylo/assets/images/icon-access-anywhere.svg"
        header="Access your files, anywhere"
        ,
        text="The ability to use a smartphone, tablet, or computer to access your account means your files follow you everywhere."
      />
      <Feature
        imagePath="/fylo/assets/images/icon-security.svg"
        header="Security you can trust"
        ,
        text="2-factor authentication and user-controlled encryption are just a
              couple of the security features we allow to help secure your
              files."
      />
      <Feature
        imagePath="/fylo/assets/images/icon-collaboration.svg"
        header="Real-time collaboration"
        ,
        text="Securely share files and folders with friends, family and colleagues for live collaboration. No email attachments required."
      />
      <Feature
        imagePath="/fylo/assets/images/icon-any-file.svg"
        header="Store any type of file"
        ,
        text="Whether you're sharing holidays photos or work documents, Fylo has you covered allowing for all file types to be securely stored and shared."
      />
    </div>
  </section>
  <Productive />

  <section class="testimonials">
    <div class="container">
      <img
        src="/fylo/assets/images/bg-quotes.png"
        alt=""
        aria-hidden="true"
      />
      <Testimonial
        quote="Fylo has improved our team productivity by an order of magnitude. Since making the switch our team has become a well-oiled collaboration machine."
        authorName="Satish Patel"
        authorTitle="Founder & CEO, Huddle"
        authorImage="/fylo/assets/images/profile-1.jpg"
      />
      <Testimonial
        quote="Fylo has improved our team productivity by an order of magnitude. Since making the switch our team has become a well-oiled collaboration machine."
        authorName="Bruce McKenzie"
        authorTitle="Founder & CEO, Huddle"
        authorImage="/fylo/assets/images/profile-2.jpg"
      />
      <Testimonial
        quote="Fylo has improved our team productivity by an order of magnitude. Since making the switch our team has become a well-oiled collaboration machine."
        authorName="Iva Boyd"
        authorTitle="Founder & CEO, Huddle"
        authorImage="/fylo/assets/images/profile-3.jpg"
      />
    </div>
  </section>
  <CTA />
</Layout>

<style lang="scss">
  .features {
    background: $colors-navy-900;

    padding-top: clamp(lib.rem(140), 8.618rem + 0.5634vw, lib.rem(146));
    padding-bottom: clamp(lib.rem(146), 10.3081rem + -1.3146vw, lib.rem(160));

    .container {
      justify-content: space-between;
      justify-items: center;
      display: grid;
      row-gap: $spacing-1000;
      grid-template-columns: 1fr;
      max-width: lib.rem(907);
      @include lib.respond-to(md) {
        grid-template-columns: lib.rem(363) lib.rem(384);
      }
    }
  }

  .testimonials {
    background: $colors-navy-900;
    padding-bottom: clamp(lib.rem(150), 7.8345rem + 6.5728vw, lib.rem(220));
    .container {
      @include lib.flex-center(column);
      gap: clamp($spacing-300, 1.1479rem + 1.5023vw, $spacing-500);
      position: relative;
      max-width: fit-content;
      @include lib.respond-to(lg) {
        flex-direction: row;
      }
      & > img {
        position: absolute;
        bottom: 99%;
        left: 0;
        z-index: 1;
      }
    }
  }
</style>
